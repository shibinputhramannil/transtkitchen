# Backend environment variables. docker-compose.yml sets development values;
# on Render these are set by render.yaml or in the dashboard. Never commit a real .env.

# Required
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://kitchenmind:kitchenmind@localhost:5432/kitchenmind

# Defaults to false. Never enable in production.
DJANGO_DEBUG=false

# Comma-separated. Render's onrender.com hostname is added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins (scheme + host, no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Optional
DATABASE_SSL_REQUIRE=false
DATABASE_CONN_MAX_AGE=60
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_LOG_LEVEL=INFO
