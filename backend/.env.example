# Backend environment variables. docker-compose.yml sets development values;
# on Render these are set by render.yaml or in the dashboard. Never commit a real .env.

# Booleans accept true/false, 1/0, yes/no, on/off (any case). Any other value,
# or a non-numeric value for a number, stops the app at startup.

# Required. DATABASE_URL must be a PostgreSQL URL. DJANGO_SECRET_KEY also signs
# sign-in tokens (JWTs), so use a long random value (at least 32 characters).
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://kitchenmind:kitchenmind@localhost:5432/kitchenmind

# Defaults to false. Never enable in production.
DJANGO_DEBUG=false

# Comma-separated. Render's onrender.com hostname is added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins (scheme + host, no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Optional
DATABASE_SSL_REQUIRE=false
DATABASE_CONN_MAX_AGE=60
# Seconds to wait when connecting before giving up (the health check reports 503).
DATABASE_CONNECT_TIMEOUT=5
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_LOG_LEVEL=INFO

# Sign-in token lifetimes. Each refresh issues a new refresh token.
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# Number of proxies in front of the API that append to X-Forwarded-For. Used to
# tell clients apart for rate limiting; leave unset until the hosting setup is
# confirmed, because a wrong value limits the wrong clients.
# DRF_NUM_PROXIES=1

# Temporary: creates the first admin account at startup if no account has this
# email (an existing account is never changed). Remove both once it exists.
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=
